# CODE DNA 3.0 Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Server Configuration
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=True

# Security Secret Keys (Use strong random strings in production)
SECRET_KEY=codedna-3-flask-secret-key-placeholder
JWT_SECRET=codedna-3-jwt-secret-key-placeholder

# Database Configuration
# Default SQLite: (leave blank to auto-create backend/codedna.db)
# DATABASE_URL=sqlite:///codedna.db
# MySQL Example:
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/codedna_db
# PostgreSQL Example:
# DATABASE_URL=postgresql://username:password@localhost:5432/codedna_db
